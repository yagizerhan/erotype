{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erotype",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Always route /api/* requests to the Worker (never fall back to the SPA)
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDO"]
    }
  ],
  // Request rate limiting (Workers Rate Limiting binding). Counters are per
  // Cloudflare PoP (approximate), sufficient against brute-force and room spam.
  // Limits are intentionally generous for shared IPs (schools, dorms, offices).
  "ratelimits": [
    { "name": "RL_STRICT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_API", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  // D1 database. Local dev ignores database_id; for production, replace with
  // the id returned by `npx wrangler d1 create erotype-db`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "erotype-db",
      "database_id": "3ab3edde-174a-4a05-acc4-6a440264cb06",
      "migrations_dir": "migrations"
    }
  ]
}
